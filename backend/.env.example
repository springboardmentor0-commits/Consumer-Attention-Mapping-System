# --- App ---
APP_NAME=Consumer Attention Mapping System
ENV=development
DEBUG=true

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- OAuth2 (Google example, used for OAuth2 login) ---
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_REDIRECT_URL=http://localhost:8000/api/v1/auth/oauth/callback

# --- PostgreSQL (primary DB: users, stores, shelves, cameras, config) ---
POSTGRES_USER=cams_user
POSTGRES_PASSWORD=cams_password
POSTGRES_DB=cams_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- MongoDB (secondary DB: sessions, events, tracking data - later milestones) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cams_events

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
